# NVRC: smi.rs nvidia_smi_srs (conf-compute -srs: GPU ready state), run in mode_gpu only when nvrc.smi.srs is set on the kernel command
# line. Value comes from /run/nvsd/smi.srs (written by nvsd-init.service, absent = unit
# skipped). A non-zero exit powers the VM off (NVRC foreground() panics).
# NVRC sets the ready state last: after the other nvidia-smi calls, hostengine, the exporter and CDI
# generation. Here it is ordered after the other nvidia-smi calls only (the settings that configure the GPU);
# hostengine, the exporter and nvidia-ctk only observe it, and kata-agent (the only consumer of a Ready GPU)
# still starts after all of them. This is a deliberate loosening of NVRC's order: it takes nvidia-ctk off the
# critical path (measured in bench/results, label final-srs).
[Unit]
Description=nvidia-smi conf-compute -srs: GPU ready state
DefaultDependencies=no
After=modprobe@nvidia.service nvidia-persistenced.service nvsd-init.service nvidia-smi-lmc.service nvidia-smi-lgc.service nvidia-smi-pl.service
ConditionPathExists=/run/nvsd/mode.gpu
ConditionPathExists=/run/nvsd/smi.srs
OnFailure=nvsd-poweroff.service

[Service]
Type=oneshot
EnvironmentFile=/run/nvsd/smi.srs
ExecSearchPath=/run/kata-extensions/gpu/bin:/usr/bin:/bin
ExecStart=nvidia-smi conf-compute -srs ${NVSD_VALUE}
StandardInput=null
StandardOutput=file:/run/nvsd/out
StandardError=inherit
