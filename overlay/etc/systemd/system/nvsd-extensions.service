# NVRC: guest_extension_image.rs mount_all(), planning half. Reconciles cold-plugged
# extension devices (virtio-blk serial "extension-<name>") 1:1 with the measured kernel
# command line (kata.extension.<name>.verity_params=...), failing closed on any mismatch, and
# writes /run/nvsd/ext-<name>.env for nvsd-extension@<name>.service. Skipped entirely (no process)
# when the VM has neither a block device with a serial nor extension parameters.
# Not ordered after nvsd-cmdline.service: ext-plan reads /proc/cmdline itself, so this chain
# and the cmdline translation run on both vCPUs at once.
# Deliberate difference: a stray kata.extension.<name>.verity_params for a name other than the shipped
# "gpu" is only noticed when a block device with a serial exists.
[Unit]
Description=Plan composable image extensions (fail closed)
DefaultDependencies=no
ConditionPathExistsGlob=|/sys/block/*/serial
ConditionKernelCommandLine=|kata.extension.gpu.verity_params
OnFailure=nvsd-poweroff.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/nvsd/nvsd-helper ext-plan
StandardOutput=null
StandardError=null
