# NVRC: kernel_params.rs process_kernel_params(), kmsg.rs kernlog_setup() (four net.core
# sysctls = 16 MiB, printk_devkmsg), execute.rs (child stdout is /dev/kmsg only for debug
# logging). Needs the helper: systemd cannot extract "nvrc.smi.lgc=1500" into an argument,
# normalise lenient booleans or write sysctls. Output lives in /run/nvsd (see helper source).
[Unit]
Description=Translate nvrc.* kernel parameters
DefaultDependencies=no
OnFailure=nvsd-poweroff.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/nvsd/nvsd-helper cmdline
StandardOutput=null
StandardError=null
