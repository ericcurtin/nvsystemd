# NVRC: lockdown.rs disable_modules_loading(), called after every mode function and right
# before kata-agent is forked: no kernel module can be loaded for the rest of the boot.
# Ordered after all four mode targets (so after every modprobe of every mode); kata-agent
# is ordered after this unit and Requires= it, so a failed lockdown never reaches the agent.
# In cpu mode nothing is ever loaded after the extension mount, so nvsd-mode.service (helper detect)
# applies the lockdown itself and drops /run/nvsd/locked; this unit is then skipped (one process
# start less on the cpu-mode critical path). In every other mode this unit runs last.
[Unit]
Description=Disable kernel module loading (lockdown)
DefaultDependencies=no
Requires=nvsd-cpu.target nvsd-gpu.target nvsd-servicevm-nvl4.target nvsd-servicevm-nvl5.target
After=nvsd-cpu.target nvsd-gpu.target nvsd-servicevm-nvl4.target nvsd-servicevm-nvl5.target
ConditionPathExists=!/run/nvsd/locked
OnFailure=nvsd-poweroff.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/nvsd/nvsd-helper lockdown
StandardOutput=null
StandardError=null
