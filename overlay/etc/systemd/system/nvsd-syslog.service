# NVRC: syslog.rs (drain /dev/log into /run/syslog.log) and the syslog_loop child that NVRC
# keeps alive next to kata-agent. Socket activated: in cpu mode, where nothing logs, it never
# runs. Not part of the fail-fast path: a drain error ends this unit, it must not power the VM
# off (NVRC uses try_poll() for exactly that reason once kata-agent runs).
[Unit]
Description=Drain /dev/log into /run/syslog.log
DefaultDependencies=no
Requires=nvsd-syslog.socket
After=nvsd-syslog.socket nvsd-init.service
# Started eagerly by nvsd-init.service in every mode but cpu, so the sink is already running when
# nvidia-persistenced logs its readiness marker (socket activation on the critical path costs a
# process start). In cpu mode nothing logs and the unit is skipped; the socket still owns /dev/log.
ConditionPathExists=!/run/nvsd/mode.cpu

[Service]
Type=simple
ExecStart=/usr/lib/nvsd/nvsd-helper syslog
StandardOutput=null
StandardError=null
