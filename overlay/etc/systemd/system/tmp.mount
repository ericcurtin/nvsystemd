# SPDX-License-Identifier: Apache-2.0
# NVRC: mount.rs setup(): tmpfs on /tmp with MS_NOSUID|MS_NODEV|MS_RELATIME.
# /proc, /sys, /dev and /run are mounted by systemd itself before any unit runs
# (its built-in API filesystem table), so they need no unit.
[Unit]
Description=/tmp (tmpfs)
DefaultDependencies=no
OnFailure=nvsd-poweroff.service

[Mount]
What=tmpfs
Where=/tmp
Type=tmpfs
Options=nosuid,nodev,relatime
