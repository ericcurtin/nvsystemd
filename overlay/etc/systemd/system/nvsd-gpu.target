# SPDX-License-Identifier: Apache-2.0
# NVRC main.rs: the "gpu" arm of the mode match. Reached only when nvsd-mode.service
# detected that mode (marker /run/nvsd/mode.gpu); units of the mode are pulled in by
# Requires= below and each carries the same condition, because systemd adds Requires=/Wants= dependencies
# to the transaction before conditions are evaluated.
[Unit]
Description=NVRC mode: gpu
DefaultDependencies=no
Requires=nvsd-mode.service modprobe@nvidia.service modprobe@nvidia-uvm.service nvsd-uvm-tools.service modprobe@ib_umad.service modprobe@mlx5_ib.service
After=nvsd-mode.service modprobe@nvidia.service modprobe@nvidia-uvm.service nvsd-uvm-tools.service modprobe@ib_umad.service modprobe@mlx5_ib.service
ConditionPathExists=/run/nvsd/mode.gpu
