# SPDX-License-Identifier: Apache-2.0
# default.target. The VM's whole boot is "reach this target"; kata-agent (the VM lifetime
# process) is the last thing it starts. Any failure to get there powers the VM off, as NVRC's
# panic hook does.
[Unit]
Description=nvsystemd boot (NVRC replacement)
DefaultDependencies=no
Wants=nvsd-base.target nvsd-cpu.target nvsd-gpu.target nvsd-servicevm-nvl4.target nvsd-servicevm-nvl5.target
Requires=kata-agent.service
After=kata-agent.service
OnFailure=nvsd-poweroff.service
JobTimeoutSec=900
JobTimeoutAction=poweroff-immediate
